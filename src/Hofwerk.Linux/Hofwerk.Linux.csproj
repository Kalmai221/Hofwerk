<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The command and executable are lowercase "hofwerk", the usual Linux style. -->
    <AssemblyName>hofwerk</AssemblyName>
  </PropertyGroup>

  <!--
    The Windows compatibility version (this app, published for win-x64) is downloaded by the standard Windows version when someone needs
    it, so it is kept small the same way the installer is: trimmed, with compiled bindings (no reflection), without debug files.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <!-- Runtime parts and symbol files that only matter for debugging, crash dumps, HTTP/3 or alternative garbage collectors. -->
  <Target Name="HofwerkSlimPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_HofwerkUnused Include="@(ResolvedFileToPublish)"
                      Condition="'%(Filename)%(Extension)' == 'mscordbi.dll'
                              Or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore'))
                              Or '%(Filename)%(Extension)' == 'clrgc.dll'
                              Or '%(Filename)%(Extension)' == 'clrgcexp.dll'
                              Or '%(Filename)%(Extension)' == 'msquic.dll'
                              Or '%(Filename)%(Extension)' == 'createdump.exe'
                              Or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))
                              Or '%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_HofwerkUnused)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The installer copies this into the user's icon theme for the applications menu. -->
    <Content Include="Assets\hofwerk.png" CopyToOutputDirectory="PreserveNewest" Link="hofwerk.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hofwerk.Core\Hofwerk.Core.csproj" />
    <ProjectReference Include="..\Hofwerk.ViewModels\Hofwerk.ViewModels.csproj" />
  </ItemGroup>
</Project>
