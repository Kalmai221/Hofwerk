<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hofwerk.ViewModels"
        xmlns:core="using:Hofwerk.Core.Omsi"
        xmlns:notes="using:Hofwerk.Core.Updates"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        x:Class="Hofwerk.Linux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1180" Height="740" MinWidth="860" MinHeight="520"
        Icon="/Assets/Hofwerk.ico"
        WindowStartupLocation="CenterScreen"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <!-- Release notes: a group title and its points (used for the installed version and for an update) -->
            <DataTemplate x:Key="ChangeGroupTemplate" x:DataType="notes:ChangeGroup">
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                                    <TextBlock Text="•" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding .}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#1B1B1F" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#151518" />
                    <SolidColorBrush x:Key="CardBackground" Color="#26262B" />
                    <SolidColorBrush x:Key="CardStroke" Color="#34343B" />
                    <SolidColorBrush x:Key="Muted" Color="#9A9AA5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F4F5F8" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#E9EBF0" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStroke" Color="#DADDE5" />
                    <SolidColorBrush x:Key="Muted" Color="#6B6F7B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Line icons, 24x24 grid -->
            <StreamGeometry x:Key="IconSettings">M4,6 H20 M4,12 H20 M4,18 H20 M9,3.5 V8.5 M15,9.5 V14.5 M7,15.5 V20.5</StreamGeometry>
            <StreamGeometry x:Key="IconGear">M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 M12,3 V6 M12,18 V21 M3,12 H6 M18,12 H21 M5.6,5.6 L7.8,7.8 M16.2,16.2 L18.4,18.4 M5.6,18.4 L7.8,16.2 M16.2,7.8 L18.4,5.6</StreamGeometry>
            <StreamGeometry x:Key="IconSign">M4,5 H20 V15 H4 Z M12,15 V20 M8,20 H16</StreamGeometry>
            <StreamGeometry x:Key="IconPin">M12,21 C12,21 5,14.5 5,9.5 A7,7 0 0 1 19,9.5 C19,14.5 12,21 12,21 Z M9.5,9.5 A2.5,2.5 0 1 0 14.5,9.5 A2.5,2.5 0 1 0 9.5,9.5</StreamGeometry>
            <StreamGeometry x:Key="IconRoute">M4,18 A2,2 0 1 0 8,18 A2,2 0 1 0 4,18 M16,6 A2,2 0 1 0 20,6 A2,2 0 1 0 16,6 M6,16 C6,10 18,14 18,8</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M12,4 L21,20 H3 Z M12,10 V14 M12,17 V17.2</StreamGeometry>
            <StreamGeometry x:Key="IconHome">M4,11 L12,4 L20,11 M6,9.5 V20 H10 V14 H14 V20 H18 V9.5</StreamGeometry>
            <StreamGeometry x:Key="IconLibrary">M5,4 H19 V8.5 H5 Z M5,10 H19 V14.5 H5 Z M5,16 H19 V20 H5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3,7 V18 H21 V9 H12 L10,7 Z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7.5</StreamGeometry>
            <StreamGeometry x:Key="IconCross">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
            <StreamGeometry x:Key="IconUp">M12,19 V5 M6,11 L12,5 L18,11</StreamGeometry>
            <StreamGeometry x:Key="IconChevron">M9,6 L15,12 L9,18</StreamGeometry>
            <StreamGeometry x:Key="IconDocument">M7,3 H14 L19,8 V21 H7 Z M14,3 V8 H19 M10,13 H16 M10,17 H16</StreamGeometry>
            <StreamGeometry x:Key="IconBus">M5,4 H19 V17 H5 Z M5,12 H19 M8,20 V17 M16,20 V17 M5,8 H19</StreamGeometry>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Path.small, Path.big">
            <Setter Property="Stroke" Value="{DynamicResource Muted}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Path.accent">
            <Setter Property="Stroke" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Path.small">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="Path.big">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Stroke" Value="{Binding $parent[ListBoxItem].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <!-- Sidebar navigation -->
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <!-- Sidebar details: section labels, count badges, file state dot -->
        <Style Selector="TextBlock.navheader">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Margin" Value="4,10,0,0" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#2A3B82F6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Ellipse.state">
            <Setter Property="Fill" Value="#22C55E" />
        </Style>
        <Style Selector="Ellipse.state.unsaved">
            <Setter Property="Fill" Value="#F59E0B" />
        </Style>

        <!-- Home tabs -->
        <Style Selector="Button.tab">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Entry lists -->
        <Style Selector="ListBox.entries">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" ColumnDefinitions="232,*">

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBackground}" Padding="12,16" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStroke}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,20">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SystemAccentColor}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBus}" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                              Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hofwerk" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="OMSI depot editor" Classes="caption" Margin="0" />
                    </StackPanel>
                </StackPanel>
                <!-- The file being edited, always in view -->
                <Border DockPanel.Dock="Bottom" Classes="card" Padding="14,12" CornerRadius="10" Margin="0,8,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="CURRENT FILE" Classes="caption" Margin="0" FontSize="11" LetterSpacing="1" />
                        <TextBlock Text="{Binding FileDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FileFolder}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding FileFolder}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" IsVisible="{Binding HasFile}">
                            <Ellipse Classes="state" Classes.unsaved="{Binding IsDirty}" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FileStateText}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Save" Click="OnSave" Padding="12,3" FontSize="12" IsVisible="{Binding IsDirty}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavFooter" DockPanel.Dock="Bottom" Classes="nav" Background="Transparent" Margin="0,8,0,0" SelectionChanged="OnFooterNavChanged">
                    <ListBoxItem Tag="appsettings" AutomationProperties.Name="App settings">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconGear}" />
                            <TextBlock Grid.Column="1" Text="App settings" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                                     IsVisible="{Binding UpdateAvailable}" ToolTip.Tip="An update is available" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
                <ListBox x:Name="Nav" Classes="nav" Background="Transparent" SelectionChanged="OnNavChanged">
                    <ListBoxItem Tag="header" IsHitTestVisible="False" Focusable="False"><TextBlock Text="START" Classes="navheader" /></ListBoxItem>
                    <ListBoxItem Tag="home" AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource IconHome}" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="header" IsHitTestVisible="False" Focusable="False" Padding="0">
                        <Border Height="1" Background="{DynamicResource Muted}" Opacity="0.45" Margin="8,10,8,2" />
                    </ListBoxItem>
                    <ListBoxItem Tag="header" IsHitTestVisible="False" Focusable="False"><TextBlock Text="EDITOR" Classes="navheader" /></ListBoxItem>
                    <ListBoxItem Tag="settings" IsEnabled="{Binding HasFile}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Data="{StaticResource IconDocument}" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="destinations" IsEnabled="{Binding HasFile}" AutomationProperties.Name="Destinations">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconSign}" />
                            <TextBlock Grid.Column="1" Text="Destinations" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasFile}"><TextBlock Text="{Binding Termini.Count}" /></Border>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="busstops" IsEnabled="{Binding HasFile}" AutomationProperties.Name="Bus stops">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconPin}" />
                            <TextBlock Grid.Column="1" Text="Bus stops" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasFile}"><TextBlock Text="{Binding BusStops.Count}" /></Border>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="routes" IsEnabled="{Binding HasFile}" AutomationProperties.Name="Routes">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconRoute}" />
                            <TextBlock Grid.Column="1" Text="Routes" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="badge" IsVisible="{Binding HasFile}"><TextBlock Text="{Binding Routes.Count}" /></Border>
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Tag="problems" IsVisible="{Binding HasProblems}" AutomationProperties.Name="Problems">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Path Classes="icon" Data="{StaticResource IconWarning}" />
                            <TextBlock Grid.Column="1" Text="Problems" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="badge"><TextBlock Text="{Binding Problems.Count}" /></Border>
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <DockPanel Grid.Column="1">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,22,28,10">
                <StackPanel>
                    <TextBlock x:Name="SectionTitle" Text="Welcome" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="SectionHint" Classes="caption" Margin="0,2,0,0" Text="Open an OMSI .hof file to begin" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="New…" Click="OnNew" AutomationProperties.Name="New file" />
                    <Button Content="Open…" Classes="accent" Click="OnOpen" />
                    <Button Content="Save" Click="OnSave" IsEnabled="{Binding IsDirty}" />
                    <Button Content="Save as…" Click="OnSaveAs" IsEnabled="{Binding FilePath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Grid>

            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Padding="28,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding FileDisplayPath}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="PrefixCharacterEllipsis" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Grid Margin="28,6,28,0">

                <!-- Home -->
                <Grid x:Name="HomePanel" RowDefinitions="Auto,Auto,*" RowSpacing="16">

                    <!-- Welcome: the two things you usually want -->
                    <Border CornerRadius="14" Padding="28,24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
                                <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark2}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22">
                            <Image Source="/Assets/hofwerk.png" Width="60" Height="60" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Welcome to Hofwerk" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="Edit destinations, bus stops and routes for OMSI. Drop a .hof file onto this window to open it."
                                               Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Open a .hof file…" Click="OnOpen" Padding="18,9" />
                                    <Button Content="New .hof file…" Click="OnNew" Padding="18,9" AutomationProperties.Name="New .hof file" />
                                    <Button Click="OnContinue" Padding="18,9" IsVisible="{Binding HasRecent}">
                                        <TextBlock Text="{Binding LatestTitle, StringFormat='Continue: {0}'}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </StackPanel>

                                <!-- A newer version, when there is one -->
                                <Border CornerRadius="10" Padding="14,12" Background="#26FFFFFF" IsVisible="{Binding UpdateAvailable}">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding UpdateHeadline}" FontWeight="SemiBold" Foreground="White"
                                                       AutomationProperties.Name="Update available" />
                                            <TextBlock Text="{Binding UpdateDetail}" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" IsVisible="{Binding IsUpdateBusy}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Update now" Command="{Binding InstallUpdateCommand}" AutomationProperties.Name="Update now" />
                                            <Button Content="What's new" Click="OnShowUpdateNotes" AutomationProperties.Name="What's new in the update" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- One list at a time -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Recent files" Classes="tab" Classes.active="{Binding ShowRecentTab}" Click="OnHomeRecent" />
                        <Button Content="OMSI library" Classes="tab" Classes.active="{Binding ShowLibraryTab}" Click="OnHomeLibrary" />
                    </StackPanel>

                    <Border Grid.Row="2" Classes="card" Margin="0,0,0,12" IsVisible="{Binding ShowRecentTab}">
                        <Grid>
                            <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasRecent}">
                                <Path Data="{StaticResource IconDocument}" Classes="big" />
                                <TextBlock Text="Files you open will show up here." Foreground="{DynamicResource Muted}" TextAlignment="Center" />
                                <Button Content="Browse the OMSI library" Click="OnHomeLibrary" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding HasOmsi}" />
                            </StackPanel>
                            <ListBox Classes="entries" ItemsSource="{Binding Recent}" SelectionChanged="OnPickEntry" IsVisible="{Binding HasRecent}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:HofFileEntry">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" AutomationProperties.Name="{Binding Title}">
                                            <Path Data="{StaticResource IconDocument}" Classes="small" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Classes="card" Margin="0,0,0,12" IsVisible="{Binding ShowLibraryTab}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                <Button Command="{Binding OmsiUpCommand}" IsVisible="{Binding CanGoUp}" Padding="8,6" ToolTip.Tip="Up one folder" AutomationProperties.Name="Up one folder">
                                    <Path Data="{StaticResource IconUp}" Classes="small" Stroke="{Binding $parent[Button].Foreground}" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OmsiLocation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OmsiHeadline}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Change OMSI folder…" Click="OnChangeOmsi" />
                            </Grid>
                            <TextBox DockPanel.Dock="Top" PlaceholderText="Search all vehicles" Text="{Binding OmsiFilter}"
                                     IsVisible="{Binding HasOmsi}" Margin="0,0,0,8" />

                            <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasOmsi}">
                                <Path Data="{StaticResource IconFolder}" Classes="big" />
                                <TextBlock Text="OMSI 2 was not found automatically." Foreground="{DynamicResource Muted}" TextAlignment="Center" />
                                <Button Content="Select the OMSI folder…" Click="OnChangeOmsi" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>

                            <ListBox Classes="entries" ItemsSource="{Binding OmsiItems}" SelectionChanged="OnPickOmsiItem" IsVisible="{Binding HasOmsi}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:OmsiItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" AutomationProperties.Name="{Binding Name}">
                                            <Path Data="{StaticResource IconFolder}" Classes="small accent" VerticalAlignment="Center" IsVisible="{Binding IsFolder}" />
                                            <Path Data="{StaticResource IconDocument}" Classes="small" VerticalAlignment="Center" IsVisible="{Binding !IsFolder}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                            <Path Grid.Column="2" Data="{StaticResource IconChevron}" Classes="small" Width="12" Height="12" VerticalAlignment="Center"
                                                  IsVisible="{Binding IsFolder}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- App settings: Hofwerk itself, not the open file -->
                <ScrollViewer x:Name="AppSettingsPanel" IsVisible="False">
                    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,16,16">

                        <!-- Appearance -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Foreground="{DynamicResource Muted}" Text="Light or dark, or follow the desktop." />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Theme" />
                                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" MinWidth="240" AutomationProperties.Name="Theme">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThemeChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Updates -->
                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding CurrentVersion, StringFormat='You have Hofwerk {0}'}" />
                                        <Button Content="{Binding InstalledNotesTitle}" Classes="link" Click="OnShowInstalledNotes" Padding="0" Background="Transparent"
                                                Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Left" AutomationProperties.Name="What's new" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" VerticalAlignment="Top"
                                            AutomationProperties.Name="Check for updates" />
                                </Grid>

                                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                                           IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" IsVisible="{Binding IsUpdateBusy}" />

                                <Border CornerRadius="8" Padding="14,12" Background="{DynamicResource SystemAccentColor}" IsVisible="{Binding UpdateAvailable}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding UpdateHeadline}" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding UpdateDetail}" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Update now" Command="{Binding InstallUpdateCommand}" AutomationProperties.Name="Update now" />
                                            <Button Content="What's new" Click="OnShowUpdateNotes" AutomationProperties.Name="What's new in the update" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ToggleSwitch Content="Look for updates when Hofwerk starts" OnContent="On" OffContent="Off"
                                              IsChecked="{Binding CheckForUpdatesOnStart}" AutomationProperties.Name="Check when Hofwerk starts" />
                                <ToggleSwitch Content="Include pre-releases (early versions that may have bugs)" OnContent="On" OffContent="Off"
                                              IsChecked="{Binding IncludePreReleases}" AutomationProperties.Name="Include pre-releases" />
                            </StackPanel>
                        </Border>

                        <!-- OMSI 2 -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="OMSI 2" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="Where your game is. Hofwerk lists its .hof files on Home and checks the folders named in your depot file." />
                                </StackPanel>
                                <TextBlock Text="{Binding OmsiFolderText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Change folder…" Click="OnChangeOmsi" AutomationProperties.Name="Change OMSI folder" />
                                    <Button Content="Find it automatically" Command="{Binding FindOmsiAutomaticallyCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- String presets -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="String presets" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Text="Names the string slots of destinations and bus stops, so “String 7” becomes something you can recognise. Pick the one that matches your bus." />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="String preset">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PresetViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12">
                                        <Run Text="{Binding SelectedPreset.Credit}" /><Run Text=" · " /><Run Text="{Binding SelectedPreset.Source}" /><Run Text=" · " /><Run Text="{Binding SelectedPreset.SlotSummary}" />
                                    </TextBlock>
                                    <Button Content="Source" Classes="link" Click="OnActivePresetLink" IsVisible="{Binding SelectedPreset.HasUrl}"
                                            Padding="0" Background="Transparent" Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Expander Header="Add your own" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                                   Text="Drop a folder with a preset.json and a strings.txt into your presets folder, then refresh. To share a preset with everyone, add the same folder to Presets/ in the project and open a pull request; the Presets/README.md explains how." />
                                        <SelectableTextBlock Text="{Binding UserPresetsFolder}" Foreground="{DynamicResource Muted}" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Open folder" Click="OnOpenPresetsFolder" />
                                            <Button Content="Refresh" Click="OnRefreshPresets" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="About" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                           Text="{Binding CurrentVersion, StringFormat='Hofwerk {0} – a modern editor for OMSI 2 .hof files. With thanks to Lukas G., creator of the original HOF Suite, for the inspiration.'}" />
                                <Button Content="Hofwerk on GitHub" Classes="link" Click="OnOpenGitHub" HorizontalAlignment="Left" Padding="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid IsVisible="{Binding HasFile}">

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPanel">
                        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,16,16">

                            <!-- General settings -->
                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="General settings" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="The name of the depot, and the destination shown when the bus is not in service."
                                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Display name" Classes="caption" Margin="0" />
                                        <TextBox Text="{Binding Name}" AutomationProperties.Name="Display name" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Service trip destination" Classes="caption" Margin="0" />
                                        <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Choose a destination"
                                                  ItemsSource="{Binding ServiceTripChoices}" SelectedItem="{Binding SelectedServiceTrip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ServiceTripChoice">
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Folders -->
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Folders" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                                   Text="The names of the folders your bus pack reads announcements and destination textures from. A tick means a folder with that name was found under Vehicles in your OMSI folder." />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Folders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FolderRow">
                                                <Grid ColumnDefinitions="130,*,28,100" ColumnSpacing="12" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip.Tip="{Binding Hint}" />
                                                    <TextBox Grid.Column="1" PlaceholderText="Folder name" Text="{Binding Name}" />
                                                    <Panel Grid.Column="2" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}">
                                                        <Path Data="{StaticResource IconCheck}" Stroke="#22C55E" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Stretch="Uniform" Width="16" Height="16" IsVisible="{Binding IsFound}" />
                                                        <Path Data="{StaticResource IconCross}" Stroke="#EF4444" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Stretch="Uniform" Width="14" Height="14" IsVisible="{Binding IsMissing}" />
                                                    </Panel>
                                                    <Button Grid.Column="3" Content="Create…" Click="OnCreateFolder" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center" IsVisible="{Binding CanCreate}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"
                                               Text="Create… asks where to make a missing folder, because that depends on the bus pack (for example Vehicles/Announcements)." />
                                </StackPanel>
                            </Border>

                            <!-- IBIS codes -->
                            <Border Classes="card">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="IBIS codes" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                                   Text="Changes the last two numbers of the IBIS code when you enter 900, 800 and 500 routes. The codes are listed in the documentation of your bus. The default is “00”." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="9xx" Classes="caption" Margin="0" />
                                            <TextBox Width="88" MaxLength="2" PlaceholderText="00" Text="{Binding Ibis9xx}" AutomationProperties.Name="9xx" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="8xx" Classes="caption" Margin="0" />
                                            <TextBox Width="88" MaxLength="2" PlaceholderText="00" Text="{Binding Ibis8xx}" AutomationProperties.Name="8xx" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="5xx" Classes="caption" Margin="0" />
                                            <TextBox Width="88" MaxLength="2" PlaceholderText="00" Text="{Binding Ibis5xx}" AutomationProperties.Name="5xx" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Advanced -->
                            <Expander Header="Advanced" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12" Margin="4,8,4,4">
                                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               Text="How many text lines OMSI reads for every destination and bus stop. Your bus decides this; change it only if you know you need to." />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Strings per destination" Classes="caption" Margin="0" />
                                            <NumericUpDown Width="200" Value="{Binding TerminusStringCount}" Minimum="0" Maximum="64" FormatString="0" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Strings per bus stop" Classes="caption" Margin="0" />
                                            <NumericUpDown Width="200" Value="{Binding BusStopStringCount}" Minimum="0" Maximum="64" FormatString="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Destinations -->
                    <Grid x:Name="DestinationsPanel" IsVisible="False" ColumnDefinitions="320,*" ColumnSpacing="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Termini.Count, StringFormat='{}{0} in this file'}" Classes="caption" Margin="0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add" Command="{Binding AddTerminusCommand}" AutomationProperties.Name="Add destination" />
                                    <Button Grid.Column="2" Content="Copy" Command="{Binding DuplicateTerminusCommand}" AutomationProperties.Name="Duplicate destination" />
                                    <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveTerminusCommand}" AutomationProperties.Name="Remove destination" />
                                </Grid>
                                <TextBox Text="{Binding TerminusFilter}" PlaceholderText="Search destinations" AutomationProperties.Name="Search destinations" />
                            </StackPanel>
                            <ListBox Classes="entries" ItemsSource="{Binding FilteredTermini}" SelectedItem="{Binding SelectedTerminus}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminusViewModel">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" DataContext="{Binding SelectedTerminus}"
                                      IsVisible="{Binding, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Border Classes="card" x:DataType="vm:TerminusViewModel" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Classes="caption" Text="Code (ident)" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Ident}" AutomationProperties.Name="Code (ident)" />
                                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding IsAllExit}"
                                              Content="All exit – nobody boards (e.g. not in service)" />
                                    <StackPanel IsVisible="{Binding !IsAllExit}">
                                        <TextBlock Classes="caption" Text="Terminus stop (where everybody gets off)" />
                                        <TextBox Text="{Binding Station}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Strings}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StringItem">
                                                <Grid ColumnDefinitions="26,200,*" ColumnSpacing="12" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Index}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip.Tip="{Binding Hint}" />
                                                    <TextBox Grid.Column="2" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bus stops -->
                    <Grid x:Name="BusStopsPanel" IsVisible="False" ColumnDefinitions="320,*" ColumnSpacing="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding BusStops.Count, StringFormat='{}{0} in this file'}" Classes="caption" Margin="0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add" Command="{Binding AddBusStopCommand}" AutomationProperties.Name="Add bus stop" />
                                    <Button Grid.Column="2" Content="Copy" Command="{Binding DuplicateBusStopCommand}" AutomationProperties.Name="Duplicate bus stop" />
                                    <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveBusStopCommand}" AutomationProperties.Name="Remove bus stop" />
                                </Grid>
                                <TextBox Text="{Binding BusStopFilter}" PlaceholderText="Search bus stops" AutomationProperties.Name="Search bus stops" />
                            </StackPanel>
                            <ListBox Classes="entries" ItemsSource="{Binding FilteredBusStops}" SelectedItem="{Binding SelectedBusStop}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BusStopViewModel">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedBusStop, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel>
                                <TextBlock Text="{Binding BusStopUsage}" Classes="caption" Margin="4,0,0,6" />
                                <Border Classes="card" DataContext="{Binding SelectedBusStop}" x:DataType="vm:BusStopViewModel" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Classes="caption" Text="Name" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Name}" AutomationProperties.Name="Name" />
                                        <ItemsControl ItemsSource="{Binding Strings}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StringItem">
                                                    <Grid ColumnDefinitions="26,200,*" ColumnSpacing="12" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Index}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip.Tip="{Binding Hint}" />
                                                        <TextBox Grid.Column="2" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Routes -->
                    <Grid x:Name="RoutesPanel" IsVisible="False" ColumnDefinitions="320,*" ColumnSpacing="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Routes.Count, StringFormat='{}{0} in this file'}" Classes="caption" Margin="0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Add" Command="{Binding AddRouteCommand}" AutomationProperties.Name="Add route" />
                                    <Button Grid.Column="2" Content="Copy" Command="{Binding DuplicateRouteCommand}" AutomationProperties.Name="Duplicate route" />
                                    <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveRouteCommand}" AutomationProperties.Name="Remove route" />
                                </Grid>
                                <TextBox Text="{Binding RouteFilter}" PlaceholderText="Search routes" AutomationProperties.Name="Search routes" />
                            </StackPanel>
                            <ListBox Classes="entries" ItemsSource="{Binding FilteredRoutes}" SelectedItem="{Binding SelectedRoute}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RouteViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StopSummary}" Classes="caption" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <ScrollViewer Grid.Column="1" IsVisible="{Binding SelectedRoute, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="12" Margin="0,0,0,12">
                                <Border Classes="card">
                                    <Grid x:Name="RouteFields" ColumnDefinitions="*,*,2*,2*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                        <TextBlock Classes="caption" Text="Route code" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="1" Text="{Binding SelectedRoute.Ident}" AutomationProperties.Name="Route code" />
                                        <TextBlock Grid.Column="1" Classes="caption" Text="Line" Margin="0,0,0,4" />
                                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedRoute.Line}" AutomationProperties.Name="Line" />
                                        <TextBlock Grid.Column="2" Classes="caption" Text="Destination" Margin="0,0,0,4" />
                                        <ComboBox Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DestinationChoices}"
                                                  SelectedItem="{Binding SelectedRouteDestination}" AutomationProperties.Name="Destination">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DestinationChoice"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="3" Classes="caption" Text="Name" Margin="0,0,0,4" />
                                        <TextBox Grid.Column="3" Grid.Row="1" Text="{Binding SelectedRoute.Name}" AutomationProperties.Name="Name" />
                                    </Grid>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding RouteWarning}" Foreground="{DynamicResource SystemAccentColor}" TextWrapping="Wrap"
                                                   IsVisible="{Binding RouteWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <Grid x:Name="StopsGrid" ColumnDefinitions="*,Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                            <StackPanel x:Name="AllStopsBox" Spacing="6">
                                                <TextBlock Text="All stops" FontWeight="SemiBold" AutomationProperties.Name="All stops" />
                                                <TextBlock Text="Bus stops defined in this file – double-click to add" Classes="caption" Margin="0" />
                                                <TextBox Text="{Binding StopPickerFilter}" PlaceholderText="Search bus stops" AutomationProperties.Name="Search bus stops to add" />
                                                <ListBox x:Name="AllStopsList" Classes="entries" Height="280" ItemsSource="{Binding StopPickerStops}"
                                                         SelectedItem="{Binding SelectedPickerStop}" DoubleTapped="OnPickerDoubleTapped">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BusStopViewModel">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                            <StackPanel x:Name="StopButtons" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Add →" Command="{Binding AddPickedStopCommand}" AutomationProperties.Name="Add stop to route" />
                                                <Button Content="↑" Command="{Binding SelectedRoute.MoveStopUpCommand}" AutomationProperties.Name="Move stop up" />
                                                <Button Content="↓" Command="{Binding SelectedRoute.MoveStopDownCommand}" AutomationProperties.Name="Move stop down" />
                                                <Button Content="Remove" Command="{Binding SelectedRoute.RemoveStopCommand}" AutomationProperties.Name="Remove stop from route" />
                                                <Button Content="Clear" Command="{Binding SelectedRoute.ClearStopsCommand}" AutomationProperties.Name="Clear route stops" />
                                            </StackPanel>
                                            <StackPanel x:Name="RouteStopsBox" Grid.Column="2" Spacing="6">
                                                <TextBlock Text="Route stops" FontWeight="SemiBold" AutomationProperties.Name="Route stops" />
                                                <TextBlock Text="{Binding SelectedRoute.StopSummary}" Classes="caption" Margin="0" />
                                                <TextBlock Text="No stops yet – double-click a stop on the left to add it."
                                                           Classes="caption" Margin="0" TextWrapping="Wrap" IsVisible="{Binding !SelectedRoute.HasStops}" />
                                                <ListBox x:Name="RouteStopsList" Classes="entries" Height="280" ItemsSource="{Binding SelectedRoute.Stops}"
                                                         SelectedItem="{Binding SelectedRoute.SelectedStop}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RouteStopViewModel">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsUnknown}"
                                                                        ToolTip.Tip="Not in your bus stop list"><TextBlock Text="?" /></Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Problems found while reading -->
                    <ListBox x:Name="ProblemsPanel" Classes="entries" IsVisible="False" ItemsSource="{Binding Problems}" />
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
