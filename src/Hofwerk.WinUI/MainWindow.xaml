<Window
    x:Class="Hofwerk.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hofwerk.WinUI"
    xmlns:vm="using:Hofwerk.ViewModels"
    xmlns:core="using:Hofwerk.Core.Omsi">

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: drawn by the app so it blends with Mica and follows light/dark mode -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Hofwerk.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Command bar -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" HorizontalAlignment="Left">
            <AppBarButton Icon="OpenFile" Label="Open" Click="OnOpen" />
            <AppBarButton Icon="Save" Label="Save" Click="OnSave" IsEnabled="{x:Bind local:MainWindow.HasFile(ViewModel.FilePath), Mode=OneWay}" />
            <AppBarButton Icon="SaveLocal" Label="Save as" Click="OnSaveAs" IsEnabled="{x:Bind local:MainWindow.HasFile(ViewModel.FilePath), Mode=OneWay}" />
        </CommandBar>

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Auto" CompactModeThresholdWidth="700" ExpandedModeThresholdWidth="1000" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="252" SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="START" />
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem Content="String Presets" Tag="presets" Icon="Library" />

                <NavigationViewItemHeader Content="EDITOR" />
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                <NavigationViewItem Content="Destinations" Tag="destinations" Icon="Switch" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.Termini.Count, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Bus stops" Tag="busstops" Icon="MapPin" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.BusStops.Count, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Routes" Tag="routes" Icon="Directions" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.Routes.Count, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Problems" Tag="problems" Icon="Important"
                                    Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.Problems.Count, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- The file being edited, always in view -->
            <NavigationView.PaneFooter>
                <Border Margin="10,4,10,12" Padding="14,12" CornerRadius="10" BorderThickness="1"
                        Visibility="{x:Bind Nav.IsPaneOpen, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CURRENT FILE" FontSize="11" Opacity="0.6" CharacterSpacing="80" />
                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.FileDisplayName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.FileFolder, Mode=OneWay}" Opacity="0.6" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.FileFolder, Mode=OneWay}" />
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                    Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{x:Bind local:MainWindow.StateBrush(ViewModel.IsDirty), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.FileStateText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                            <Button Content="Save" Click="OnSave" Padding="12,3" FontSize="12"
                                    Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </NavigationView.PaneFooter>

            <Grid x:Name="PageHost" Padding="24,8,24,16" SizeChanged="OnPageHostSizeChanged">
                <Grid.Resources>
                    <!-- Used by the Home, Settings and String Presets pages -->
                    <Style x:Key="SectionCard" TargetType="Border">
                        <Setter Property="Padding" Value="20" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Style>
                </Grid.Resources>

                <!-- Home -->
                <Grid x:Name="HomePanel" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Welcome: the two things you usually want -->
                    <Border CornerRadius="14" Padding="28,24">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{ThemeResource SystemAccentColorLight1}" Offset="0" />
                                <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/Hofwerk.png" Width="60" Height="60" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Welcome to Hofwerk" Style="{ThemeResource TitleTextBlockStyle}" Foreground="White" />
                                    <TextBlock Text="Edit destinations, bus stops and routes for OMSI. You can also drop a .hof file onto this window."
                                               TextWrapping="Wrap" Foreground="#E6FFFFFF" />
                                </StackPanel>
                                <StackPanel x:Name="HeroButtons" Orientation="Horizontal" Spacing="10">
                                    <Button Click="OnOpen" Padding="18,9">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                            <TextBlock Text="Open a .hof file…" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnContinue" Padding="18,9" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="{x:Bind ViewModel.LatestTitle, Mode=OneWay}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- One list at a time -->
                    <SelectorBar x:Name="HomeTabs" Grid.Row="1" HorizontalAlignment="Left" SelectionChanged="OnHomeTab">
                        <SelectorBarItem Text="Recent files" />
                        <SelectorBarItem Text="OMSI library" />
                    </SelectorBar>

                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Visibility="{x:Bind ViewModel.ShowRecentTab, Mode=OneWay}">
                        <Grid>
                            <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{x:Bind local:MainWindow.Not(ViewModel.HasRecent), Mode=OneWay}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="30" Opacity="0.35" />
                                <TextBlock Text="Files you open will show up here." Opacity="0.65" TextAlignment="Center" />
                                <Button Content="Browse the OMSI library" Click="OnShowLibrary" HorizontalAlignment="Center" Margin="0,8,0,0"
                                        Visibility="{x:Bind ViewModel.HasOmsi, Mode=OneWay}" />
                            </StackPanel>
                            <ListView ItemsSource="{x:Bind ViewModel.Recent}" IsItemClickEnabled="True" SelectionMode="None"
                                      ItemClick="OnPickEntry" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:HofFileEntry">
                                        <Grid ColumnSpacing="12" Padding="0,6" AutomationProperties.Name="{x:Bind Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8A5;" FontSize="18" Opacity="0.7" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Visibility="{x:Bind ViewModel.ShowLibraryTab, Mode=OneWay}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{x:Bind ViewModel.OmsiUpCommand}" Padding="8,6" ToolTipService.ToolTip="Up one folder" AutomationProperties.Name="Up one folder"
                                        Visibility="{x:Bind ViewModel.CanGoUp, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE74A;" FontSize="14" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.OmsiLocation, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.OmsiHeadline, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Change OMSI folder…" Click="OnChangeOmsi" />
                            </Grid>

                            <TextBox Grid.Row="1" PlaceholderText="Search all vehicles" Visibility="{x:Bind ViewModel.HasOmsi, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.OmsiFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{x:Bind local:MainWindow.Not(ViewModel.HasOmsi), Mode=OneWay}">
                                <FontIcon Glyph="&#xE7C1;" FontSize="30" Opacity="0.35" />
                                <TextBlock Text="OMSI 2 was not found automatically." Opacity="0.65" TextAlignment="Center" />
                                <Button Content="Select the OMSI folder…" Click="OnChangeOmsi" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>

                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.OmsiItems}" IsItemClickEnabled="True" SelectionMode="None"
                                      ItemClick="OnPickOmsiItem" Visibility="{x:Bind ViewModel.HasOmsi, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:OmsiItem">
                                        <Grid ColumnSpacing="12" Padding="0,5" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource SystemAccentColor}" Visibility="{x:Bind IsFolder}" />
                                            <FontIcon Glyph="&#xE8A5;" FontSize="18" Opacity="0.7" VerticalAlignment="Center"
                                                      Visibility="{x:Bind local:MainWindow.Not(IsFolder)}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind local:MainWindow.HasText(Detail)}" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.5" VerticalAlignment="Center"
                                                      Visibility="{x:Bind IsFolder}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Preset library -->
                <ScrollViewer x:Name="PresetsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="String Presets" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="A preset names the string slots of destinations and bus stops, so “String 7” becomes something you can recognise. Pick the one that matches your bus." />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetViewModel">
                                    <Border Padding="20" Margin="0,0,0,12" CornerRadius="12" BorderThickness="1"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Credit}" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Opacity="0.6" FontSize="12">
                                                    <Run Text="{x:Bind Source}" /><Run Text=" · " /><Run Text="{x:Bind SlotSummary}" />
                                                </TextBlock>
                                                <HyperlinkButton Content="Source" Padding="0" Click="OnPresetLink"
                                                                 Visibility="{x:Bind HasUrl}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="Use this preset" Click="OnUsePreset"
                                                        Visibility="{x:Bind local:MainWindow.Not(IsActive), Mode=OneWay}" />
                                                <TextBlock Text="✓ In use" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="20" CornerRadius="12" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Add your own" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                           Text="Drop a folder with a preset.json and a strings.txt into your presets folder, then refresh. To share a preset with everyone, add the same folder to Presets/ in the project and open a pull request; the Presets/README.md explains how." />
                                <TextBlock Text="{x:Bind ViewModel.UserPresetsFolder}" Opacity="0.6" FontSize="12" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open folder" Click="OnOpenPresetsFolder" />
                                    <Button Content="Refresh" Click="OnRefreshPresets" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,16,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock Text="What applies to this whole depot file." Opacity="0.7" />
                        </StackPanel>

                        <!-- General settings -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="General settings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="The name of the depot, and the destination shown when the bus is not in service." Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox Header="Display name" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Header="Service trip destination" HorizontalAlignment="Stretch" PlaceholderText="Choose a destination"
                                          ItemsSource="{x:Bind ViewModel.ServiceTripChoices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedServiceTrip, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ServiceTripChoice">
                                            <TextBlock Text="{x:Bind Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Folders -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Folders" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.65"
                                               Text="The names of the folders your bus pack reads announcements and destination textures from. A tick means a folder with that name was found under Vehicles in your OMSI folder." />
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Folders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FolderRow">
                                            <Grid ColumnSpacing="12" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Hint}" />
                                                <TextBox Grid.Column="1" PlaceholderText="Folder name"
                                                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind IsFound, Mode=OneWay}" />
                                                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                              Visibility="{x:Bind IsMissing, Mode=OneWay}" />
                                                </Grid>
                                                <Button Grid.Column="3" Content="Create…" Click="OnCreateFolder" HorizontalAlignment="Stretch"
                                                        Visibility="{x:Bind CanCreate, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                           Text="Create… asks where to make a missing folder, because that depends on the bus pack (for example Vehicles\Announcements)." />
                            </StackPanel>
                        </Border>

                        <!-- IBIS codes -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="IBIS codes" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.65"
                                               Text="Changes the last two numbers of the IBIS code when you enter 900, 800 and 500 routes. The codes are listed in the documentation of your bus. The default is “00”." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <TextBox Header="9xx" Width="88" MaxLength="2" InputScope="Number" PlaceholderText="00" BeforeTextChanging="OnDigitsOnly"
                                             Text="{x:Bind ViewModel.Ibis9xx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="8xx" Width="88" MaxLength="2" InputScope="Number" PlaceholderText="00" BeforeTextChanging="OnDigitsOnly"
                                             Text="{x:Bind ViewModel.Ibis8xx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="5xx" Width="88" MaxLength="2" InputScope="Number" PlaceholderText="00" BeforeTextChanging="OnDigitsOnly"
                                             Text="{x:Bind ViewModel.Ibis5xx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Advanced -->
                        <Expander Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock TextWrapping="Wrap" Opacity="0.65"
                                           Text="How many text lines OMSI reads for every destination and bus stop. Your bus decides this; change it only if you know you need to." />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <NumberBox Header="Strings per destination" Minimum="0" Maximum="64" SpinButtonPlacementMode="Inline" Width="200"
                                               Value="{x:Bind local:MainWindow.D(ViewModel.TerminusStringCount), Mode=OneWay}" ValueChanged="OnTerminusCount" />
                                    <NumberBox Header="Strings per bus stop" Minimum="0" Maximum="64" SpinButtonPlacementMode="Inline" Width="200"
                                               Value="{x:Bind local:MainWindow.D(ViewModel.BusStopStringCount), Mode=OneWay}" ValueChanged="OnBusStopCount" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Destinations -->
                <Grid x:Name="DestinationsPanel" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" MaxWidth="340" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Border x:Name="DestListPane" Style="{StaticResource SectionCard}" Padding="14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Destinations" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.6"><Run Text="{x:Bind ViewModel.Termini.Count, Mode=OneWay}" /><Run Text=" in this file" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AddTerminusCommand}" Padding="9,7" ToolTipService.ToolTip="Add a destination" AutomationProperties.Name="Add destination"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.DuplicateTerminusCommand}" Padding="9,7" ToolTipService.ToolTip="Duplicate the selected destination" AutomationProperties.Name="Duplicate destination"><FontIcon Glyph="&#xE8C8;" FontSize="14" /></Button>
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.RemoveTerminusCommand}" Padding="9,7" ToolTipService.ToolTip="Remove the selected destination" AutomationProperties.Name="Remove destination"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                            </Grid>
                            <TextBox Grid.Row="1" PlaceholderText="Search destinations" Text="{x:Bind ViewModel.TerminusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredTermini}" SelectedItem="{x:Bind ViewModel.SelectedTerminus, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminusViewModel">
                                        <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}" Visibility="{x:Bind IsAllExit, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Nobody boards: everybody gets off">
                                                <TextBlock Text="exit only" FontSize="11" Opacity="0.8" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="DestDetailPane" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedTerminus), Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,0,8,12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Destination" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="200" /><ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Header="Code (ident)" Text="{x:Bind ViewModel.SelectedTerminus.Ident, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Terminus stop (where everybody gets off)"
                                                 Visibility="{x:Bind local:MainWindow.Not(ViewModel.SelectedTerminus.IsAllExit), Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.SelectedTerminus.Station, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <CheckBox Content="No passengers: nobody boards, everybody gets off (for example “not in service”)"
                                              IsChecked="{x:Bind ViewModel.SelectedTerminus.IsAllExit, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Display strings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="What each display on the bus shows. The names come from your string preset." Opacity="0.65" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTerminus.Strings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StringItem">
                                                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" MinWidth="110" MaxWidth="230" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Index}" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}" />
                                                    <TextBox Grid.Column="2" FontFamily="Cascadia Mono, Consolas"
                                                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Column="1" Text="Select a destination, or add one with +." Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{x:Bind local:MainWindow.IsNull(ViewModel.SelectedTerminus), Mode=OneWay}" />
                </Grid>

                <!-- Bus stops -->
                <Grid x:Name="BusStopsPanel" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" MaxWidth="340" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Border x:Name="StopListPane" Style="{StaticResource SectionCard}" Padding="14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bus stops" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.6"><Run Text="{x:Bind ViewModel.BusStops.Count, Mode=OneWay}" /><Run Text=" in this file" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AddBusStopCommand}" Padding="9,7" ToolTipService.ToolTip="Add a bus stop" AutomationProperties.Name="Add bus stop"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.DuplicateBusStopCommand}" Padding="9,7" ToolTipService.ToolTip="Duplicate the selected bus stop" AutomationProperties.Name="Duplicate bus stop"><FontIcon Glyph="&#xE8C8;" FontSize="14" /></Button>
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.RemoveBusStopCommand}" Padding="9,7" ToolTipService.ToolTip="Remove the selected bus stop" AutomationProperties.Name="Remove bus stop"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                            </Grid>
                            <TextBox Grid.Row="1" PlaceholderText="Search bus stops" Text="{x:Bind ViewModel.BusStopFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredBusStops}" SelectedItem="{x:Bind ViewModel.SelectedBusStop, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BusStopViewModel">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="StopDetailPane" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedBusStop), Mode=OneWay}">
                        <StackPanel Spacing="12" Padding="0,0,8,12">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Bus stop" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBox Header="Name" Text="{x:Bind ViewModel.SelectedBusStop.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{x:Bind ViewModel.BusStopUsage, Mode=OneWay}" Opacity="0.65" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Display strings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="What the bus displays and announces for this stop. The names come from your string preset." Opacity="0.65" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedBusStop.Strings, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StringItem">
                                                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" MinWidth="110" MaxWidth="230" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Index}" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}" />
                                                    <TextBox Grid.Column="2" FontFamily="Cascadia Mono, Consolas"
                                                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Column="1" Text="Select a bus stop, or add one with +." Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{x:Bind local:MainWindow.IsNull(ViewModel.SelectedBusStop), Mode=OneWay}" />
                </Grid>

                <!-- Routes -->
                <Grid x:Name="RoutesPanel" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="260" MaxWidth="340" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Border x:Name="RouteListPane" Style="{StaticResource SectionCard}" Padding="14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Routes" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.6"><Run Text="{x:Bind ViewModel.Routes.Count, Mode=OneWay}" /><Run Text=" in this file" /></TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AddRouteCommand}" Padding="9,7" ToolTipService.ToolTip="Add a route" AutomationProperties.Name="Add route"><FontIcon Glyph="&#xE710;" FontSize="14" /></Button>
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.DuplicateRouteCommand}" Padding="9,7" ToolTipService.ToolTip="Duplicate the selected route" AutomationProperties.Name="Duplicate route"><FontIcon Glyph="&#xE8C8;" FontSize="14" /></Button>
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.RemoveRouteCommand}" Padding="9,7" ToolTipService.ToolTip="Remove the selected route" AutomationProperties.Name="Remove route"><FontIcon Glyph="&#xE74D;" FontSize="14" /></Button>
                            </Grid>
                            <TextBox Grid.Row="1" PlaceholderText="Search routes" Text="{x:Bind ViewModel.RouteFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.FilteredRoutes}" SelectedItem="{x:Bind ViewModel.SelectedRoute, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RouteViewModel">
                                        <StackPanel AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StopSummary, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="RouteDetailPane" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedRoute), Mode=OneWay}">
                      <Grid RowSpacing="12" Padding="0,0,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Route details -->
                        <Border Style="{StaticResource SectionCard}" Padding="16">
                            <Grid x:Name="RouteHeaderGrid" ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="RouteFieldCode" Grid.ColumnSpan="1" Header="Route code"
                                         Text="{x:Bind ViewModel.SelectedRoute.Ident, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="RouteFieldLine" Grid.Column="1" Header="Line"
                                         Text="{x:Bind ViewModel.SelectedRoute.Line, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="RouteFieldDestination" Grid.Column="2" Grid.ColumnSpan="2" Header="Destination" HorizontalAlignment="Stretch"
                                          PlaceholderText="Choose a destination" ItemsSource="{x:Bind ViewModel.DestinationChoices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRouteDestination, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DestinationChoice">
                                            <TextBlock Text="{x:Bind Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="RouteFieldName" Grid.Column="4" Grid.ColumnSpan="2" Header="Name"
                                         Text="{x:Bind ViewModel.SelectedRoute.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <!-- Stops: pick from the defined bus stops -->
                        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16">
                            <Grid x:Name="RouteStopsEditor" ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="0" />
                                </Grid.RowDefinitions>

                                <!-- All defined bus stops -->
                                <Grid x:Name="AllStopsPane" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="All stops" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Bus stops defined in this file" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1" PlaceholderText="Search bus stops" Text="{x:Bind ViewModel.StopPickerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ListView x:Name="AllStopsList" Grid.Row="2" Height="300" ItemsSource="{x:Bind ViewModel.StopPickerStops}" SelectedItem="{x:Bind ViewModel.SelectedPickerStop, Mode=TwoWay}"
                                              DoubleTapped="OnPickerDoubleTapped">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BusStopViewModel">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock Grid.Row="3" Text="Double-click a stop to add it to the route." FontSize="12" Opacity="0.6" />
                                </Grid>

                                <!-- Add, remove and reorder -->
                                <StackPanel x:Name="StopButtons" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.AddPickedStopCommand}" ToolTipService.ToolTip="Add the selected stop to the route" AutomationProperties.Name="Add stop to route"><FontIcon Glyph="&#xE72A;" FontSize="14" /></Button>
                                    <Button Command="{x:Bind ViewModel.SelectedRoute.RemoveStopCommand, Mode=OneWay}" ToolTipService.ToolTip="Remove the selected stop from the route" AutomationProperties.Name="Remove stop from route"><FontIcon Glyph="&#xE72B;" FontSize="14" /></Button>
                                    <Button Command="{x:Bind ViewModel.SelectedRoute.MoveStopUpCommand, Mode=OneWay}" ToolTipService.ToolTip="Move the stop up" AutomationProperties.Name="Move stop up"><FontIcon Glyph="&#xE74A;" FontSize="14" /></Button>
                                    <Button Command="{x:Bind ViewModel.SelectedRoute.MoveStopDownCommand, Mode=OneWay}" ToolTipService.ToolTip="Move the stop down" AutomationProperties.Name="Move stop down"><FontIcon Glyph="&#xE74B;" FontSize="14" /></Button>
                                    <Button Command="{x:Bind ViewModel.SelectedRoute.ClearStopsCommand, Mode=OneWay}" ToolTipService.ToolTip="Remove all stops from the route" AutomationProperties.Name="Remove all stops"><FontIcon Glyph="&#xE894;" FontSize="14" /></Button>
                                </StackPanel>

                                <!-- The route's stops, in order -->
                                <Grid x:Name="RouteStopsPane" Grid.Column="2" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Route stops" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedRoute.StopSummary, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                    <InfoBar Grid.Row="1" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.RouteWarning, Mode=OneWay}"
                                             IsOpen="{x:Bind local:MainWindow.NotEmpty(ViewModel.RouteWarning), Mode=OneWay}" />
                                    <ListView x:Name="RouteStopsList" Grid.Row="2" Height="300" ItemsSource="{x:Bind ViewModel.SelectedRoute.Stops, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRoute.SelectedStop, Mode=TwoWay}" CanReorderItems="True" AllowDrop="True">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RouteStopViewModel">
                                                <Grid ColumnSpacing="12" MinHeight="34" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="2" Fill="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{ThemeResource SystemAccentColor}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <FontIcon Grid.Column="2" Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                                                              Visibility="{x:Bind IsUnknown, Mode=OneWay}"
                                                              ToolTipService.ToolTip="No bus stop with this name is defined in this file" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock Grid.Row="2" Margin="12,14,12,0" TextWrapping="Wrap" VerticalAlignment="Top" Opacity="0.65"
                                               Visibility="{x:Bind local:MainWindow.Not(ViewModel.SelectedRoute.HasStops), Mode=OneWay}"
                                               Text="No stops yet. Choose a stop in the list on the left and press the arrow, or double-click it." />
                                    <TextBlock Grid.Row="3" Text="Drag stops to change their order." FontSize="12" Opacity="0.6" />
                                </Grid>
                            </Grid>
                        </Border>
                      </Grid>
                    </ScrollViewer>
                    <TextBlock Grid.Column="1" Text="Select a route, or add one with +." Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="{x:Bind local:MainWindow.IsNull(ViewModel.SelectedRoute), Mode=OneWay}" />
                </Grid>

                <!-- Problems found while reading -->
                <ListView x:Name="ProblemsPanel" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Problems}" SelectionMode="None" />
            </Grid>
        </NavigationView>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="520" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FileDisplayPath, Mode=OneWay}" Opacity="0.6" TextTrimming="CharacterEllipsis"
                       TextAlignment="Right" HorizontalAlignment="Right" ToolTipService.ToolTip="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
