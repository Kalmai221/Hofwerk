<Window
    x:Class="Hofwerk.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hofwerk.WinUI"
    xmlns:vm="using:Hofwerk.ViewModels"
    xmlns:core="using:Hofwerk.Core.Omsi">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: drawn by the app so it blends with Mica and follows light/dark mode -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Hofwerk.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Command bar -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" HorizontalAlignment="Left">
            <AppBarButton Icon="OpenFile" Label="Open" Click="OnOpen" />
            <AppBarButton Icon="Save" Label="Save" Click="OnSave" IsEnabled="{x:Bind local:MainWindow.HasFile(ViewModel.FilePath), Mode=OneWay}" />
            <AppBarButton Icon="SaveLocal" Label="Save as" Click="OnSaveAs" IsEnabled="{x:Bind local:MainWindow.HasFile(ViewModel.FilePath), Mode=OneWay}" />
        </CommandBar>

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="200" SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Presets" Tag="presets" Icon="Library" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                <NavigationViewItem Content="Destinations" Tag="destinations" Icon="Switch" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                <NavigationViewItem Content="Bus stops" Tag="busstops" Icon="MapPin" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                <NavigationViewItem Content="Routes" Tag="routes" Icon="Directions" IsEnabled="{x:Bind ViewModel.HasFile, Mode=OneWay}" />
                <NavigationViewItem Content="Problems" Tag="problems" Icon="Important"
                                    Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}" />
            </NavigationView.MenuItems>

            <Grid Padding="24,8,24,16">

                <!-- Home -->
                <Grid x:Name="HomePanel" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="28" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Edit your OMSI depot files" Style="{ThemeResource TitleTextBlockStyle}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock Text="Destinations, bus stops and routes in one place. Your file's original encoding is kept when you save."
                                           TextWrapping="Wrap" MaxWidth="520"
                                           Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open a .hof file…" Click="OnOpen" Padding="22,10" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="20" CornerRadius="12" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Recent files" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Text="Files you open will show up here." Opacity="0.7"
                                           Visibility="{x:Bind local:MainWindow.Not(ViewModel.HasRecent), Mode=OneWay}" />
                                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Recent}" IsItemClickEnabled="True" SelectionMode="None"
                                          ItemClick="OnPickEntry" Visibility="{x:Bind ViewModel.HasRecent, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:HofFileEntry">
                                            <StackPanel Padding="0,4">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Padding="20" CornerRadius="12" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="OMSI library" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Text="{x:Bind local:MainWindow.FolderText(ViewModel.OmsiFolder), Mode=OneWay}" />
                                <TextBox Grid.Row="2" PlaceholderText="Filter by vehicle or file name"
                                         Visibility="{x:Bind ViewModel.HasOmsi, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.OmsiFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.OmsiFiles}" IsItemClickEnabled="True" SelectionMode="None"
                                          ItemClick="OnPickEntry" Visibility="{x:Bind ViewModel.HasOmsi, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="core:HofFileEntry">
                                            <StackPanel Padding="0,4">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Preset library -->
                <ScrollViewer x:Name="PresetsPanel" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="String presets" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="A preset names the string slots of destinations and bus stops, so “String 7” becomes something you can recognise. Pick the one that matches your bus." />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetViewModel">
                                    <Border Padding="20" Margin="0,0,0,12" CornerRadius="12" BorderThickness="1"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind Name}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Credit}" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Opacity="0.6" FontSize="12">
                                                    <Run Text="{x:Bind Source}" /><Run Text=" · " /><Run Text="{x:Bind SlotSummary}" />
                                                </TextBlock>
                                                <HyperlinkButton Content="Source" Padding="0" Click="OnPresetLink"
                                                                 Visibility="{x:Bind HasUrl}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="Use this preset" Click="OnUsePreset"
                                                        Visibility="{x:Bind local:MainWindow.Not(IsActive), Mode=OneWay}" />
                                                <TextBlock Text="✓ In use" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                           Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="20" CornerRadius="12" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Add your own" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                           Text="Drop a folder with a preset.json and a strings.txt into your presets folder, then refresh. To share a preset with everyone, add the same folder to Presets/ in the project and open a pull request; the Presets/README.md explains how." />
                                <TextBlock Text="{x:Bind ViewModel.UserPresetsFolder}" Opacity="0.6" FontSize="12" IsTextSelectionEnabled="True" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open folder" Click="OnOpenPresetsFolder" />
                                    <Button Content="Refresh" Click="OnRefreshPresets" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                    <Border MaxWidth="560" HorizontalAlignment="Left" Padding="20" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBox Header="Name of the depot" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Service trip (destination shown when not in service)" Text="{x:Bind ViewModel.ServiceTrip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <NumberBox Header="Strings per destination" Minimum="0" Maximum="64" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                                       Value="{x:Bind local:MainWindow.D(ViewModel.TerminusStringCount), Mode=OneWay}" ValueChanged="OnTerminusCount" />
                            <NumberBox Header="Strings per bus stop" Minimum="0" Maximum="64" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                                       Value="{x:Bind local:MainWindow.D(ViewModel.BusStopStringCount), Mode=OneWay}" ValueChanged="OnBusStopCount" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Destinations -->
                <Grid x:Name="DestinationsPanel" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListView ItemsSource="{x:Bind ViewModel.Termini}" SelectedItem="{x:Bind ViewModel.SelectedTerminus, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TerminusViewModel">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Add" Command="{x:Bind ViewModel.AddTerminusCommand}" />
                            <Button Content="Remove" Command="{x:Bind ViewModel.RemoveTerminusCommand}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1" Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedTerminus), Mode=OneWay}">
                        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBox Header="Code (ident)" Text="{x:Bind ViewModel.SelectedTerminus.Ident, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="All exit – nobody boards (e.g. not in service)" IsChecked="{x:Bind ViewModel.SelectedTerminus.IsAllExit, Mode=TwoWay}" />
                                <TextBox Header="Terminus stop (where everybody gets off)"
                                         Visibility="{x:Bind local:MainWindow.Not(ViewModel.SelectedTerminus.IsAllExit), Mode=OneWay}"
                                         Text="{x:Bind ViewModel.SelectedTerminus.Station, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTerminus.Strings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StringItem">
                                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Index}" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Hint}" />
                                                <TextBox Grid.Column="2" FontFamily="Cascadia Mono, Consolas"
                                                         Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- Bus stops -->
                <Grid x:Name="BusStopsPanel" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListView ItemsSource="{x:Bind ViewModel.BusStops}" SelectedItem="{x:Bind ViewModel.SelectedBusStop, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BusStopViewModel">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Add" Command="{x:Bind ViewModel.AddBusStopCommand}" />
                            <Button Content="Remove" Command="{x:Bind ViewModel.RemoveBusStopCommand}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1" Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedBusStop), Mode=OneWay}">
                        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="14">
                                <TextBox Header="Name" Text="{x:Bind ViewModel.SelectedBusStop.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedBusStop.Strings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StringItem">
                                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Index}" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Hint}" />
                                                <TextBox Grid.Column="2" FontFamily="Cascadia Mono, Consolas"
                                                         Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <!-- Routes -->
                <Grid x:Name="RoutesPanel" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListView ItemsSource="{x:Bind ViewModel.Routes}" SelectedItem="{x:Bind ViewModel.SelectedRoute, Mode=TwoWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RouteViewModel">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Add" Command="{x:Bind ViewModel.AddRouteCommand}" />
                            <Button Content="Remove" Command="{x:Bind ViewModel.RemoveRouteCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="12" Visibility="{x:Bind local:MainWindow.NotNull(ViewModel.SelectedRoute), Mode=OneWay}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="20" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Route code" Text="{x:Bind ViewModel.SelectedRoute.Ident, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Destination code" Text="{x:Bind ViewModel.SelectedRoute.TerminusIdent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" Header="Line" Text="{x:Bind ViewModel.SelectedRoute.Line, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="3" Header="Name" Text="{x:Bind ViewModel.SelectedRoute.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind ViewModel.SelectedRoute.Stops, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedRoute.SelectedStop, Mode=TwoWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StringItem">
                                        <TextBox Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Add stop" Command="{x:Bind ViewModel.SelectedRoute.AddStopCommand, Mode=OneWay}" />
                                <Button Content="Remove stop" Command="{x:Bind ViewModel.SelectedRoute.RemoveStopCommand, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Problems found while reading -->
                <ListView x:Name="ProblemsPanel" Visibility="Collapsed" ItemsSource="{x:Bind ViewModel.Problems}" SelectionMode="None" />
            </Grid>
        </NavigationView>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="16,6" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.8" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="500" />
        </Grid>
    </Grid>
</Window>
